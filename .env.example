# Copy to .env for local development. See DEPLOY.md for production setup on Vercel.

# --- Auth (required) ---
# Shared household password used to gate the whole app.
APP_PASSWORD=changeme
# Secret used to sign the login session cookie. Any long random string.
# Falls back to APP_PASSWORD if unset (fine for local dev, set a real value in production).
AUTH_SECRET=

# --- Database ---
# Local dev default: a file-based SQLite DB, no account needed.
DATABASE_URL=file:./local.db
# Only needed when DATABASE_URL points at a real Turso database (libsql://...).
DATABASE_AUTH_TOKEN=

# --- Claude API (required for meal plan generation) ---
# https://console.anthropic.com/ - billed separately from Claude.ai/Pro.
ANTHROPIC_API_KEY=
# Optional override, defaults to a current Claude model in code if unset.
ANTHROPIC_MODEL=

# --- Unsplash (optional) ---
# https://unsplash.com/developers - free tier. If unset, recipe cards fall back
# to bundled local category illustrations instead of real photos (see DECISIONS.md).
UNSPLASH_ACCESS_KEY=
