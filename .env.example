# Copy to .env for local development. See DEPLOY.md for production setup on Vercel.

# --- Auth (required) ---
# Sign-up invite code (see DECISIONS.md's "Sign-up journey" entry) - each
# household creates its own account (auto-generated username + own chosen
# password) at /signup, gated behind this shared code so sign-up stays
# limited to people you've actually given it to. Not a login password itself.
APP_PASSWORD=changeme
# Secret used to sign the login session cookie. Any long random string.
# Falls back to APP_PASSWORD if unset (fine for local dev, set a real value in production).
AUTH_SECRET=

# --- Database ---
# Leave unset for local dev/tests: falls back to an embedded PGlite database
# (./local-pgdata/), no Postgres install or account needed.
# In production: add Postgres from the Vercel dashboard's Storage tab
# (Vercel Postgres, Neon-backed) and it auto-injects this var - no manual
# copy-paste needed. See DEPLOY.md.
DATABASE_URL=

# --- Claude API (required for meal plan generation) ---
# https://console.anthropic.com/ - billed separately from Claude.ai/Pro.
ANTHROPIC_API_KEY=
# Optional override, defaults to a current Claude model in code if unset.
ANTHROPIC_MODEL=

# --- Unsplash (optional) ---
# https://unsplash.com/developers - free tier. If unset, recipe cards fall back
# to bundled local category illustrations instead of real photos (see DECISIONS.md).
UNSPLASH_ACCESS_KEY=
